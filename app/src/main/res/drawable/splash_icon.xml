<?xml version="1.0" encoding="utf-8"?>
<!-- Launch animation (Android splash screen): the flask outline draws, the liquid rises, bubbles pop. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <group android:name="liquid" android:translateY="18">
                <clip-path android:pathData="M48,46 L32,76 Q30,82 36,82 L72,82 Q78,82 76,76 L60,46 Z" />
                <path android:fillColor="#2BD9A8" android:pathData="M38.4,64 L69.6,64 L76,76 Q78,82 72,82 L36,82 Q30,82 32,76 Z" />
                <path android:fillColor="#3D7BFF" android:fillAlpha="0.55" android:pathData="M35.2,70 L72.8,70 L76,76 Q78,82 72,82 L36,82 Q30,82 32,76 Z" />
            </group>
            <group android:name="bubbles" android:pivotX="54" android:pivotY="53" android:scaleX="0" android:scaleY="0">
                <path android:fillColor="#2BD9A8" android:pathData="M51,56 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" />
                <path android:fillColor="#2BD9A8" android:pathData="M57.5,50 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
            </group>
            <path android:name="flask" android:strokeColor="#F2F4F7" android:strokeWidth="3.6" android:strokeLineCap="round" android:strokeLineJoin="round"
                android:fillColor="#00000000" android:trimPathEnd="0"
                android:pathData="M48,28 L48,46 L32,76 Q30,82 36,82 L72,82 Q78,82 76,76 L60,46 L60,28" />
            <path android:name="rim" android:strokeColor="#F2F4F7" android:strokeWidth="3.6" android:strokeLineCap="round" android:fillColor="#00000000"
                android:trimPathEnd="0" android:pathData="M44,28 L64,28" />
        </vector>
    </aapt:attr>
    <target android:name="flask">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:duration="520"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="rim">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:duration="220" android:startOffset="380"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="liquid">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateY" android:valueFrom="18" android:valueTo="0" android:duration="460" android:startOffset="300"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="bubbles">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:duration="260" android:startOffset="640"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:duration="260" android:startOffset="640"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
