<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except plain HTTP to this phone's own loopback address: that's where the
     desktop's local AI appears through `adb reverse` (USB or Wireless debugging). Traffic never
     leaves the adb tunnel, and every request carries a shared key. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
