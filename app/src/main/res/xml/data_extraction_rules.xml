<?xml version="1.0" encoding="utf-8"?>
<!-- API keys are encrypted with a device-bound keystore key, so they are useless on another
     device and are never included in cloud backups or device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="blacklab_secrets.xml" />
        <exclude domain="file" path="crashes/" />
        <exclude domain="file" path="signatures/" />
        <exclude domain="file" path="bh/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="blacklab_secrets.xml" />
        <exclude domain="file" path="crashes/" />
        <exclude domain="file" path="signatures/" />
        <exclude domain="file" path="bh/" />
    </device-transfer>
</data-extraction-rules>
